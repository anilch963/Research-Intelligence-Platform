# Copy to backend/.env and fill in.
OPENAI_API_KEY=sk-...

# Models
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Judge model used by RAGAS. A stronger judge gives more trustworthy scores.
EVAL_LLM_MODEL=gpt-4o-mini

# Retrieval: vector | hybrid
RETRIEVER_MODE=vector
TOP_K=4
# Hybrid only; vector weight = 1 - BM25_WEIGHT
BM25_WEIGHT=0.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
